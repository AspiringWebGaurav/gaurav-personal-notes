# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
out/
.vite/
.vite-temp/
*.tsbuildinfo

# Package manager logs & temporary files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/

