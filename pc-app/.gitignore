# ==============================================================================
# Gaurav Personal Notes (GPN) - PC Desktop Application (.gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Secrets, Environment Files & Credentials (CRITICAL - ZERO SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.env.*
*.local
src-tauri/.env
src-tauri/.env.*

# Auth tokens, private keys, certificates & service accounts
*.key
*.pem
*.crt
*.cer
*.der
*.pfx
*.p12
*.keystore
*.jks
private.key
signing.key
tauri.keystore
tauri.autoupdate.key
token.json
tokens.json
credentials.json
client_secret*.json
service-account*.json
google-services.json
firebase-admin*.json
auth-state.json

# ------------------------------------------------------------------------------
