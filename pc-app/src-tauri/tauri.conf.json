{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gaurav Personal Notes",
  "mainBinaryName": "Gaurav Personal Notes",
  "version": "0.0.13",
  "identifier": "com.gpn.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Gaurav Patil",
    "homepage": "https://gauravpatil.site",
    "shortDescription": "GPN - Local-first personal notes and collaborative workspace",
    "longDescription": "Gaurav Personal Notes native desktop application with instant local SQLite storage, full-text search, and background cloud synchronization.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/README.txt": "README.txt",
      "resources/ABOUT_ME.txt": "ABOUT_ME.txt"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/uninstall.ico",
        "template": "nsis/installer.nsi"
      }
    }
  },
  "plugins": {}
}
