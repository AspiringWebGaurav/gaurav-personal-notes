{
  "css.lint.unknownAtRules": "ignore",
  "css.validate": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "terminal.integrated.cwd": "${workspaceFolder}/mobile-app",
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype/**",
    "**/META-INF/maven/**",
    "**/pc-app/**",
    "**/dist/**",
    "**/target/**",
    "**/.next/**",
    "**/mobile-app/android/.gradle/**",
    "**/mobile-app/android/build/**",
    "**/mobile-app/android/app/build/**",
    "**/mobile-app/android/capacitor-cordova-android-plugins/build/**"
  ],
  "java.project.resourceFilters": [
    "node_modules",
    ".git",
    "build",
    ".gradle"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/pc-app/target/**": true,
    "**/mobile-app/android/.gradle/**": true,
    "**/mobile-app/android/app/build/**": true,
    "**/.git/objects/**": true
  }
}