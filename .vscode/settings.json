{
  "css.lint.unknownAtRules": "ignore",
  "css.validate": false,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "terminal.integrated.cwd": "${workspaceFolder}/mobile-app",
  "java.configuration.updateBuildConfiguration": "interactive",
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype/**",
    "**/META-INF/maven/**",
    "**/pc-app/**",
    "**/dist/**",
    "**/target/**",
    "**/.next/**"
  ],
  "java.project.resourceFilters": [
    "node_modules",
    ".git"
  ],
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/pc-app/target/**": true,
    "**/.git/objects/**": true
  }
}