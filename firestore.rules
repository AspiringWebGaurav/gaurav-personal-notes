rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Users collection and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Personal Notes, Money Tracker, Todos
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. Public Profiles
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 3. Collaboration Invite Codes
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    
    // 4. Lobbies
    match /lobbies/{lobbyId} {
      // Anyone authenticated can read lobbies (needed to check status)
      allow read: if request.auth != null;
      // Host can create, participants can update via Cloud Functions
      allow write: if request.auth != null; 
      
      match /members/{memberId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == memberId;
      }
    }
    
    // 5. Collaborative Notes
    match /collabNotes/{noteId} {
      allow read, write: if request.auth != null; // Refined RBAC to be implemented in P1
      
      match /members/{memberId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // 6. Smart Burn Notes (View-Once)
    match /burn_notes/{token} {
      // Must be authenticated to create a burn note
      allow create: if request.auth != null;
      // Anyone with the exact cryptographic token can read and delete it (self-destruct mechanism)
      allow read, delete: if true;
      allow update: if false; // Burn notes are strictly immutable
    }
    
    // 7. Legacy shared notes fallback
    match /notes/{noteId} {
      allow read, write: if request.auth != null;
    }
  }
}
